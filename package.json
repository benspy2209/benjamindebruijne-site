{
  "name": "ben-site",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest run",
    "e2e": "astro build && (astro preview --port 4173 --background || true) && playwright test; s=$?; astro preview stop >/dev/null 2>&1; exit $s"
  },
  "dependencies": {
    "astro": "^7.3.5"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "vitest": "^5.0.3"
  }
}
