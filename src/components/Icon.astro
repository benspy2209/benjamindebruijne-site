---
interface Props { name: 'chevron' | 'chevron-left' | 'plus' | 'check' | 'linkedin' | 'github' | 'mail' | 'arrow-ext'; class?: string }
const { name, class: cls } = Astro.props;
---
{name === 'chevron' && <svg class={cls} viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M4 2l4 4-4 4"/></svg>}
{name === 'chevron-left' && <svg class={cls} viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M8 2L4 6l4 4"/></svg>}
{name === 'plus' && <svg class={cls} viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M6 1v10M1 6h10"/></svg>}
{name === 'check' && <svg class={cls} viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M2 6.5l2.6 2.5L10 3.5"/></svg>}
{name === 'linkedin' && <svg class={cls} viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M3.3 1.5a1.8 1.8 0 110 3.6 1.8 1.8 0 010-3.6zM1.8 6h3v8.5h-3zM6.5 6h2.9v1.2c.4-.8 1.4-1.4 2.8-1.4 3 0 3.5 2 3.5 4.5v4.2h-3v-3.7c0-.9 0-2-1.3-2s-1.5 1-1.5 2v3.7h-3z"/></svg>}
{name === 'github' && <svg class={cls} viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 .5a7.5 7.5 0 00-2.4 14.6c.4.1.5-.2.5-.4v-1.3c-2.1.5-2.5-1-2.5-1-.3-.9-.8-1.1-.8-1.1-.7-.5.1-.5.1-.5.8.1 1.2.8 1.2.8.7 1.2 1.8.8 2.2.6.1-.5.3-.8.5-1-1.7-.2-3.4-.8-3.4-3.7 0-.8.3-1.5.8-2-.1-.2-.3-1 .1-2 0 0 .6-.2 2 .8a7 7 0 013.8 0c1.4-1 2-.8 2-.8.4 1 .2 1.8.1 2 .5.5.8 1.2.8 2 0 2.9-1.8 3.5-3.4 3.7.3.2.5.7.5 1.4v2.1c0 .2.1.5.5.4A7.5 7.5 0 008 .5z"/></svg>}
{name === 'mail' && <svg class={cls} viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><rect x="1.5" y="3" width="13" height="10" rx="1"/><path d="M1.5 4l6.5 5 6.5-5"/></svg>}
{name === 'arrow-ext' && <svg class={cls} viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M3 9l6-6M4 3h5v5"/></svg>}
