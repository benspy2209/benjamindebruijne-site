---
import type { Lang } from '../../lib/i18n';
import { getSite } from '../../lib/content';
interface Props { lang: Lang }
const { lang } = Astro.props;
const s = getSite(lang);
const items = [...s.logos, ...s.logos, ...s.logos];
---
<section class="mq" aria-label={s.logosLabel}>
  <p class="label wrap mq__label">{s.logosLabel}</p>
  <div class="mq__track" aria-hidden="true">
    <ul class="mq__list">
      {items.map((l) => (
        <li class="mq__item">
          {l.src ? <img src={l.src} alt="" loading="lazy" /> : <span class="mq__name">{l.name}</span>}
        </li>
      ))}
    </ul>
  </div>
  <ul class="sr-only">{s.logos.map((l) => <li>{l.name}</li>)}</ul>
</section>
<style>
  .mq { border-bottom: 1px solid var(--c-grey-300); background: var(--c-grey-100); }
  .mq__label { padding-block: 12px; border-bottom: 1px solid var(--c-grey-300); display: flex; }
  .mq__track { overflow: hidden; }
  .mq__list { display: flex; width: max-content; animation: mq 60s linear infinite; }
  .mq__item { width: 200px; height: 120px; display: grid; place-items: center; border-right: 1px solid var(--c-grey-300); padding: 24px; }
  .mq__item img { max-height: 36px; max-width: 128px; width: auto; height: auto; object-fit: contain; filter: brightness(0); opacity: .82; }
  .mq__name { font-weight: 700; font-size: 17px; letter-spacing: -.02em; color: var(--c-dark); opacity: .82; white-space: nowrap; }
  @keyframes mq { to { transform: translateX(-33.333%); } }
  .mq__track:hover .mq__list { animation-play-state: paused; }
  @media (prefers-reduced-motion: reduce) { .mq__list { animation: none; } }
</style>
