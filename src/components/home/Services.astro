---
import type { Lang } from '../../lib/i18n';
import { href } from '../../lib/i18n';
import { getSite } from '../../lib/content';
import SectionHead from '../SectionHead.astro';
import Button from '../Button.astro';
import Icon from '../Icon.astro';
import { offerRoute } from '../../lib/i18n';
import type { RouteKey } from '../../lib/i18n';
interface Props { lang: Lang; num?: string; open?: boolean }
const { lang, num = '03', open = false } = Astro.props;
const s = getSite(lang);
const sv = s.services;
const bookHref = s.meta.booking || href('contact', lang);
---
<section class="svc dark trame section" id="services">
  <div class="wrap">
    <div class="svc__top">
      <SectionHead num={num} label={sv.label} title={sv.title} intro={sv.intro} introStrong={sv.introStrong} class="svc__head" />
      <aside class="svc__card">
        <p class="label">{sv.cardLabel}</p>
        <p class="svc__ctitle h-sm lines">{sv.cardTitle.map((l) => <span>{l}</span>)}</p>
        <div class="svc__cfoot">
          <img src="/benjamin.jpg" alt="" width="72" height="72" loading="lazy" />
          <div>
            <p class="svc__cname">{sv.cardName}</p>
            <p class="mono muted">{sv.cardRole}</p>
            <Button href={bookHref} label={sv.cardCta} variant="ghost" class="svc__ccta" external={!!s.meta.booking} />
          </div>
        </div>
      </aside>
    </div>
    <div class="svc__list">
      {sv.items.map((it, i) => (
        <details class="svc__item" open={open || undefined}>
          <summary class="svc__sum">
            <span class="mono num">0{i + 1}</span>
            <span class="svc__name">{it.name}</span>
            <span class="svc__plus" aria-hidden="true"><Icon name="plus" /></span>
          </summary>
          <div class="svc__body">
            <div class="svc__text">
              <h3 class="h-md">{it.title}</h3>
              <p>{it.p1}</p>
              <p>{it.p2}</p>
              <Button href={href(offerRoute[it.slug] as RouteKey, lang)} label={sv.more} variant="ghost" class="svc__more" />
            </div>
            <div class="svc__steps">
              <p class="label">{sv.steps}</p>
              <ol class="mono">{it.steps.map((st, j) => <li><span class="num">0{j + 1}</span>{st}</li>)}</ol>
            </div>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
<style>
  .svc__top { display: grid; gap: 48px; }
  .svc__card { background: var(--c-dark-2); border: 1px solid var(--c-white-20); padding: 20px; display: grid; gap: 24px; align-self: start; }
  .svc__ctitle { font-weight: 600; text-transform: uppercase; }
  .svc__cfoot { display: flex; gap: 16px; align-items: start; }
  .svc__cfoot img { width: 72px; height: 72px; object-fit: cover; }
  .svc__cname { font-weight: 600; font-size: 13px; text-transform: uppercase; }
  .svc__ccta { margin-top: 10px; }
  .svc__ccta .btn__i { width: 28px; }
  .svc__list { margin-top: 64px; display: grid; gap: 8px; }
  .svc__item { background: var(--c-dark-2); border: 1px solid var(--c-white-05); }
  .svc__sum { list-style: none; display: grid; grid-template-columns: 48px 1fr auto; align-items: center; gap: 12px; padding: 22px 20px; cursor: pointer; font-size: 13px; font-weight: 600; text-transform: uppercase; letter-spacing: .01em; }
  .svc__sum::-webkit-details-marker { display: none; }
  .svc__sum .num { opacity: .5; }
  .svc__plus { width: 24px; height: 24px; display: grid; place-items: center; transition: transform .4s var(--ease-out-strong); }
  .svc__plus svg { width: 12px; height: 12px; }
  .svc__item[open] .svc__plus { transform: rotate(45deg); }
  .svc__body { display: grid; gap: 32px; padding: 8px 20px 36px 20px; border-top: 1px solid var(--c-white-05); }
  .svc__text { display: grid; gap: 16px; max-width: 60ch; }
  .svc__text h3 { margin-bottom: 8px; }
  .svc__text p { color: var(--c-white-60); font-size: 15px; }
  .svc__more { margin-top: 8px; justify-self: start; }
  .svc__steps ol { display: grid; gap: 10px; margin-top: 16px; }
  .svc__steps li { text-transform: none; letter-spacing: 0; font-family: var(--font-sans); font-size: 14px; }
  .svc__steps .num { opacity: .5; margin-right: 10px; }
  @media (width >= 810px) {
    .svc__top { grid-template-columns: 2fr 1fr; align-items: start; }
    .svc__sum { padding: 26px 48px 26px 20px; }
    .svc__body { grid-template-columns: 2fr 1fr; padding: 16px 48px 48px 80px; }
  }
</style>
