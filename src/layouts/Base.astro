---
import '../styles/global.css';
import type { Lang, RouteKey } from '../lib/i18n';
import { alternate, locale, href } from '../lib/i18n';
import { getSite } from '../lib/content';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
type Crumb = { name: string; href: string };
interface Props { lang: Lang; routeKey: RouteKey; slug?: string; title?: string; description?: string; onDark?: boolean; noindex?: boolean; breadcrumbs?: Crumb[]; jsonLd?: Record<string, unknown>[]; dateModified?: string; ogImage?: string; headerCta?: { label: string; suffix?: string; href: string; external?: boolean }; paths?: Record<Lang, string>; ogType?: string }
const { lang, routeKey, slug, title, description, onDark = false, noindex = false, breadcrumbs = [], jsonLd = [], dateModified, ogImage = '/og.jpg', headerCta, paths, ogType = 'website' } = Astro.props;
const s = getSite(lang);
const pageTitle = title ? `${title.replace(/[.\s]+$/, '')} — ${s.meta.name}` : s.meta.title;
const desc = description ?? s.meta.description;
const site = Astro.site ?? new URL('http://localhost:4321');
const canonical = new URL(Astro.url.pathname, site);
const other = lang === 'fr' ? 'en' : 'fr';
const altPath = paths ? paths[other] : alternate(routeKey, lang, slug);
const alt = new URL(altPath, site);
const self = paths ? paths[lang] : slug ? `${href('projects', lang)}${slug}/` : href(routeKey, lang);
const xDefault = paths ? paths.fr : slug ? `${href('projects', 'fr')}${slug}/` : href(routeKey, 'fr');
const origin = site.origin;
const personId = `${origin}/#person`;
const orgId = `${origin}/#organization`;
const websiteId = `${origin}/#website`;
const address = { '@type': 'PostalAddress', addressLocality: 'Rhode-Saint-Genèse', addressRegion: 'Brabant flamand', addressCountry: 'BE' };
const graph: Record<string, unknown>[] = [
  {
    '@type': 'Person', '@id': personId, name: s.meta.name, jobTitle: s.meta.role, description: s.meta.description,
    email: s.meta.email, url: `${origin}/`, image: new URL('/benjamin.jpg', site).toString(),
    sameAs: s.meta.sameAs, knowsAbout: s.meta.knowsAbout, address,
    worksFor: { '@id': orgId }, knowsLanguage: ['fr', 'en', 'nl'],
  },
  { '@type': ['Organization', 'ProfessionalService'], '@id': orgId, name: 'Hakuna Matata SRL', url: `${origin}/`, founder: { '@id': personId }, address, areaServed: { '@type': 'Country', name: 'Belgium' } },
  { '@type': 'WebSite', '@id': websiteId, url: `${origin}/`, name: s.meta.name, inLanguage: locale[lang], publisher: { '@id': personId } },
  { '@type': 'WebPage', '@id': canonical.toString(), url: canonical.toString(), name: pageTitle, description: desc, inLanguage: locale[lang], isPartOf: { '@id': websiteId }, about: { '@id': personId }, ...(dateModified ? { dateModified } : {}) },
  ...(breadcrumbs.length ? [{ '@type': 'BreadcrumbList', itemListElement: breadcrumbs.map((b, i) => ({ '@type': 'ListItem', position: i + 1, name: b.name, item: new URL(b.href, site).toString() })) }] : []),
  ...jsonLd,
];
---
<!doctype html>
<html lang={locale[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="msvalidate.01" content="1C785C4D3BB817604B39D79145206F8D" />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={lang} href={new URL(self, site)} />
    <link rel="alternate" hreflang={lang === 'fr' ? 'en' : 'fr'} href={alt} />
    <link rel="alternate" hreflang="x-default" href={new URL(xDefault, site)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href="/fonts/zalando-sans-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/geist-mono-latin.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={s.meta.name} />
    <meta property="og:site_name" content={s.meta.name} />
    <meta property="og:locale" content={locale[lang].replace('-', '_')} />
    <meta property="og:locale:alternate" content={locale[other].replace('-', '_')} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={desc} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': graph })} />
  </head>
  <body>
    <a href="#main" class="skip mono">Skip to content</a>
    <Header lang={lang} routeKey={routeKey} slug={slug} onDark={onDark} cta={headerCta} altHref={paths ? altPath : undefined} />
    <main id="main"><slot /></main>
    <Footer lang={lang} />
    <script>
      const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const els = document.querySelectorAll<HTMLElement>('.reveal');
      if (reduced || !('IntersectionObserver' in window)) els.forEach((e) => e.classList.add('is-in'));
      else {
        const io = new IntersectionObserver((entries) => entries.forEach((en) => { if (en.isIntersecting) { en.target.classList.add('is-in'); io.unobserve(en.target); } }), { rootMargin: '0px 0px -10% 0px' });
        els.forEach((e) => io.observe(e));
      }
      const blocks = [...document.querySelectorAll<HTMLElement>('[data-words]')].map((el) => ({ el, words: [...el.querySelectorAll<HTMLElement>('.w')], lit: -1 }));
      const paint = () => {
        const vh = innerHeight;
        for (const b of blocks) {
          const r = b.el.getBoundingClientRect();
          const p = reduced ? 1 : Math.min(1, Math.max(0, (vh * 0.85 - r.top) / (r.height + vh * 0.25)));
          const n = Math.round(p * b.words.length);
          if (n === b.lit) continue;
          b.words.forEach((w, i) => w.classList.toggle('on', i < n));
          b.lit = n;
        }
      };
      if (blocks.length) { paint(); let raf = 0; addEventListener('scroll', () => { cancelAnimationFrame(raf); raf = requestAnimationFrame(paint); }, { passive: true }); addEventListener('resize', paint); }
      document.querySelectorAll<HTMLElement>('[data-count]').forEach((el) => {
        const target = Number(el.dataset.count); const suffix = el.dataset.suffix ?? '';
        const render = (v: number) => { el.textContent = `${Math.round(v)}${suffix}`; };
        if (reduced) { render(target); return; }
        render(0);
        const io = new IntersectionObserver((ens) => { if (!ens[0].isIntersecting) return; io.disconnect();
          const t0 = performance.now(); const dur = 1400;
          const step = (t: number) => { const p = Math.min(1, (t - t0) / dur); render(target * (1 - Math.pow(1 - p, 3))); if (p < 1) requestAnimationFrame(step); };
          requestAnimationFrame(step);
        }, { threshold: .4 });
        io.observe(el);
      });
    </script>
  </body>
</html>
<style is:global>
  .skip { position: absolute; left: 8px; top: -60px; z-index: 50; background: var(--c-accent); color: #fff; padding: 8px 12px; }
  .skip:focus { top: 8px; }
</style>
