---
import ArticleView from '../../../views/ArticleView.astro';
import { getPosts, slugOf } from '../../../lib/blog';
export async function getStaticPaths() {
  return (await getPosts('en')).map((post) => ({ params: { slug: slugOf(post) }, props: { post } }));
}
const { post } = Astro.props;
---
<ArticleView lang="en" post={post} />
