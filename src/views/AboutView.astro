---
import type { Lang } from '../lib/i18n';
import { href, locale } from '../lib/i18n';
import { getSite } from '../lib/content';
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Button from '../components/Button.astro';
import Faq from '../components/Faq.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
const s = getSite(lang);
const a = s.pages.about;
const updated = new Date(a.lastUpdated).toLocaleDateString(locale[lang], { dateStyle: 'long' });
---
<Base lang={lang} routeKey="about" title={a.title.join(' ')} description={a.description} dateModified={a.lastUpdated} onDark>
  <PageHead num="01" label={s.nav.find((n) => n.key === 'about')!.label} title={a.title} intro={a.intro} introStrong={a.introStrong} />
  <section class="ab trame section">
    <div class="wrap ab__in">
      <div class="ab__photo"><img src="/benjamin.jpg" alt={s.meta.name} width="704" height="704" loading="lazy" /></div>
      <div class="ab__text">
        {a.paragraphs.map((p) => <p class="reveal">{p}</p>)}
        <p class="reveal"><a href={href('offer-deliver', lang)} class="ab__link">{a.piloterLink} →</a></p>
        <p class="reveal"><a href={href('biopharma', lang)} class="ab__link">{s.pages.biopharma.title.join(' ')} {s.pages.biopharma.introStrong} →</a></p>
        <blockquote class="ab__bio reveal">
          <p class="label ab__biolabel">{a.bioLabel}</p>
          <p class="ab__biotext">{a.bio}</p>
        </blockquote>
        <p class="label ab__flabel">{a.factsLabel}</p>
        <dl class="ab__facts">{a.facts.map((f) => <><dt class="mono muted">{f.k}</dt><dd>{f.v}</dd></>)}</dl>
        <Button href={href('contact', lang)} label={s.mission.cta} suffix={s.mission.ctaSuffix} class="ab__cta" />
        <p class="mono muted ab__updated">{a.updatedLabel} <time datetime={a.lastUpdated}>{updated}</time></p>
      </div>
    </div>
  </section>
  <Faq label={a.faqLabel} items={a.faq} num="02" />
</Base>
<style>
  .ab__in { display: grid; gap: 40px; }
  .ab__photo img { width: 100%; aspect-ratio: 1; object-fit: cover; object-position: top; border-top: 2px solid var(--c-accent); }
  .ab__text { display: grid; gap: 20px; font-size: 17px; line-height: 1.6; max-width: 60ch; align-content: start; }
  .ab__flabel { margin-top: 24px; }
  .ab__facts { display: grid; grid-template-columns: auto 1fr; gap: 10px 24px; margin: 0; font-size: 15px; }
  .ab__facts dd { margin: 0; }
  .ab__cta { margin-top: 16px; justify-self: start; }
  .ab__link { border-bottom: 1px solid var(--c-accent); font-weight: 600; }
  .ab__bio { margin: 8px 0 0; padding: 20px 24px; border-left: 2px solid var(--c-accent); background: var(--c-grey-100, rgba(0,0,0,.04)); display: grid; gap: 10px; }
  .ab__biolabel { margin: 0; }
  .ab__biotext { margin: 0; font-size: 15px; line-height: 1.6; }
  .ab__updated { font-size: 12px; margin: 0; }
  @media (width >= 810px) { .ab__in { grid-template-columns: 1fr 2fr; } }
</style>
