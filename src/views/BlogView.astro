---
import type { Lang } from '../lib/i18n';
import { locale } from '../lib/i18n';
import { getSite } from '../lib/content';
import { getPosts, postHref, slugOf } from '../lib/blog';
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Icon from '../components/Icon.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
const s = getSite(lang);
const b = s.pages.blog;
const posts = await getPosts(lang);
const fmt = (d: Date) => d.toLocaleDateString(locale[lang], { dateStyle: 'long' });
---
<Base lang={lang} routeKey="blog" title={b.title.join(' ')} description={b.description} onDark>
  <PageHead num="01" label="Blog" title={b.title} intro={b.intro} introStrong={b.introStrong} />
  <section class="trame section">
    <div class="wrap">
      {posts.length === 0 ? <p class="mono muted">{b.empty}</p> : (
        <ul class="bl__list">
          {posts.map((p) => (
            <li class="reveal">
              <a href={postHref(slugOf(p), lang)} class="bl__item">
                <time class="mono muted" datetime={p.data.date.toISOString().slice(0, 10)}>{fmt(p.data.date)}</time>
                <span class="bl__title h-md">{p.data.title}</span>
                <span class="bl__desc muted">{p.data.description}</span>
                <span class="bl__read mono">{b.read} <span class="of__arrow"><Icon name="chevron" /></span></span>
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>
</Base>
<style>
  .bl__list { border-top: 1px solid var(--c-grey-300); }
  .bl__item { display: grid; gap: 10px; padding: 32px 0; border-bottom: 1px solid var(--c-grey-300); }
  .bl__desc { font-size: 16px; line-height: 1.6; max-width: 64ch; }
  .bl__read { display: inline-flex; align-items: center; gap: 10px; margin-top: 6px; }
  .of__arrow { width: 28px; height: 28px; background: var(--c-accent); color: #fff; display: grid; place-items: center; }
  .of__arrow :global(svg) { width: 10px; height: 10px; }
  @media (width >= 810px) { .bl__item { grid-template-columns: 180px 1fr; grid-template-areas: "date title" "date desc" "date read"; gap: 10px 32px; } .bl__item time { grid-area: date; padding-top: 6px; } .bl__title { grid-area: title; } .bl__desc { grid-area: desc; } .bl__read { grid-area: read; } }
</style>
