---
import type { Lang } from '../lib/i18n';
import { locale } from '../lib/i18n';
import { getSite } from '../lib/content';
import { cardOf, getPosts, postHref, rubriqueOf, slugOf } from '../lib/blog';
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Icon from '../components/Icon.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
const s = getSite(lang);
const b = s.pages.blog;
const posts = await getPosts(lang);
const fmt = (d: Date) => d.toLocaleDateString(locale[lang], { dateStyle: 'long' });
---
<Base lang={lang} routeKey="blog" title={b.title.join(' ')} description={b.description} onDark>
  <PageHead num="01" label="Blog" title={b.title} intro={b.intro} introStrong={b.introStrong} />
  <section class="trame section">
    <div class="wrap">
      {posts.length === 0 ? <p class="mono muted">{b.empty}</p> : (
        <ul class="bl__list">
          {posts.map((p) => (
            <li class="reveal">
              <a href={postHref(slugOf(p), lang)} class="bl__item">
                <span class="bl__meta mono muted"><time datetime={p.data.date.toISOString().slice(0, 10)}>{fmt(p.data.date)}</time><span class="bl__rub">{rubriqueOf(p, lang).label}</span></span>
                <span class="bl__title h-md">{p.data.title}</span>
                <span class="bl__desc muted">{p.data.description}</span>
                <span class="bl__read mono">{b.read} <span class="of__arrow"><Icon name="chevron" /></span></span>
                {cardOf(p, lang) && <img src={cardOf(p, lang)!} alt="" width="1200" height="1200" class="bl__card" loading="lazy" decoding="async" />}
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>
</Base>
<style>
  .bl__list { border-top: 1px solid var(--c-grey-300); }
  .bl__item { display: grid; gap: 10px; padding: 32px 0; border-bottom: 1px solid var(--c-grey-300); }
  .bl__meta { display: flex; flex-wrap: wrap; gap: 4px 12px; }
  .bl__rub { color: var(--c-accent); }
  .bl__desc { font-size: 16px; line-height: 1.6; max-width: 64ch; }
  .bl__read { display: inline-flex; align-items: center; gap: 10px; margin-top: 6px; }
  .bl__card { width: 100%; max-width: 240px; height: auto; display: block; border: 1px solid var(--c-grey-300); }
  .of__arrow { width: 28px; height: 28px; background: var(--c-accent); color: #fff; display: grid; place-items: center; }
  .of__arrow :global(svg) { width: 10px; height: 10px; }
  @media (width >= 810px) { .bl__item { grid-template-columns: 180px 1fr 240px; grid-template-areas: "date title card" "date desc card" "date read card"; gap: 10px 32px; align-items: start; } .bl__card { grid-area: card; justify-self: end; } .bl__meta { grid-area: date; padding-top: 6px; flex-direction: column; } .bl__title { grid-area: title; } .bl__desc { grid-area: desc; } .bl__read { grid-area: read; } }
</style>
