---
import type { Lang } from '../lib/i18n';
import { getSite } from '../lib/content';
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
const s = getSite(lang);
const b = s.pages.blog;
---
<Base lang={lang} routeKey="blog" title={b.title.join(' ')} onDark>
  <PageHead num="01" label="Blog" title={b.title} intro={b.intro} introStrong={b.introStrong} />
  <section class="trame section"><div class="wrap"><p class="mono muted">{b.empty}</p></div></section>
</Base>
