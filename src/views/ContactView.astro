---
import type { Lang } from '../lib/i18n';
import { getSite } from '../lib/content';
import Base from '../layouts/Base.astro';
import ContactForm from '../components/home/ContactForm.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
const s = getSite(lang);
---
<Base lang={lang} routeKey="contact" title={s.contact.title.join(' ')} description={s.contact.description}>
  <div class="pad"></div>
  <ContactForm lang={lang} num="01" as="h1" />
</Base>
<style>.pad { height: var(--header-h); }</style>
