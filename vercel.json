    {
      "source": "/contact",
      "destination": "/contact/",
      "permanent": true
    },
    {
      "source": "/admin/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/services",
      "destination": "https://asterisme.ai/",
      "permanent": true
    },
    {
      "source": "/services/:path*",
      "destination": "https://asterisme.ai/",
      "permanent": true
    },
    {
      "source": "/en/services",
      "destination": "https://asterisme.ai/",
      "permanent": true
    },
    {
      "source": "/en/services/:path*",
      "destination": "https://asterisme.ai/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
