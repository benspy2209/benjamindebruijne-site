      "permanent": true
    },
    {
      "source": "/en/conformite-cybersecurite",
      "destination": "https://asterisme.ai/",
      "permanent": true
    },
    {
      "source": "/en/ia",
      "destination": "https://asterisme.ai/",
      "permanent": true
    },
    {
      "source": "/devis/:slug",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/projets/:id",
      "destination": "/projets/",
      "permanent": true
    },
    {
      "source": "/veille",
      "destination": "https://asterisme.ai/",
      "permanent": true
    },
    {
      "source": "/conseils",
      "destination": "https://asterisme.ai/",
      "permanent": true
